    0.0,
    1.36
   ],
   "text": [
    "EU PRECISAVA",
    "DO DINHEIRO."
   ]
  },
  {
   "voice": "davi",
   "src": [
    1.79,
    6.65
   ],
   "text": [
    "TURNO DA NOITE,",
    "KM 317.",
    "PAGA EM DOBRO."
   ]
  },
  {
   "voice": "sonia",
   "src": [
    0.0,
    2.67
   ],
   "text": [
    "DAVI? AQUI É",
    "A SÔNIA,",
    "A GERENTE."
   ]
  },
  {
   "voice": "sonia",
   "src": [
    3.0,
    7.31
   ],
   "text": [
    "BEM-VINDO.",
    "AS REGRAS ESTÃO",
    "NO CAIXA.",
    "LEIA TODAS."
   ]
  },
  {
   "voice": "davi",
   "src": [
    7.01,
    9.44
   ],
   "text": [
    "REGRA UM:",
    "AS LUZES NUNCA",
    "SE APAGAM."
   ]
  },
  {
   "voice": "davi",
   "src": [
    9.66,
    15.49
   ],
   "text": [
    "REGRA DOIS:",
    "DAS 3H ÀS 3H33,",
    "NÃO OLHE",
    "PARA REFLEXOS."
   ]
  },
  {
   "voice": "davi",
   "src": [
    15.71,
    19.28
   ],
   "text": [
    "REGRA TRÊS:",
    "NINGUÉM PEDE",
    "O DE SEMPRE.",
    "SE PEDIREM,",
    "ESTÁ FECHADO."
   ]
  },
  {
   "voice": "davi",
   "src": [
    19.66,
    20.93
   ],
   "text": [
    "ASSINADO: IVO."
   ]
  },
  {
   "voice": "davi",
   "src": [
    21.44,
    26.3
   ],
   "text": [
    "ATÉ AS DUAS,",
    "NADA.",
    "UM CASAL,",
    "UM MOTOQUEIRO,",
    "UM CACHORRO",
    "SOZINHO."
   ]
  },
  {
   "voice": "davi",
   "src": [
    26.73,
    30.69
   ],
   "text": [
    "ÀS 2H59,",
    "AS LUZES PISCARAM.",
    "TODAS JUNTAS."
   ]
  },
  {
   "voice": "davi",
   "src": [
    31.03,
    33.95
   ],
   "text": [
    "O SININHO TOCOU.",
    "A PORTA ABRIU.",
    "NINGUÉM ENTROU."
   ]
  },
  {
   "voice": "davi",
   "src": [
    34.44,
    37.87
   ],
   "text": [
    "NAS CÂMERAS,",
    "NINGUÉM.",
    "NEM NAS BOMBAS.",
    "NEM NA ESTRADA."
   ]
  },
  {
   "voice": "bento",
   "src": [
    0.0,
    2.02
   ],
   "text": [
    "BOA NOITE, RAPAZ!",
    "FRIO, NÉ?"
   ]
  },
  {
   "voice": "bento",
   "src": [
    2.44,
    3.2
   ],
   "text": [
    "ME VÊ",
    "O DE SEMPRE."
   ]
  },
  {
   "voice": "davi",
   "src": [
    38.26,
    40.08
   ],
   "text": [
    "O DE SEMPRE.",
    "REGRA TRÊS."
   ]
  },
  {
   "voice": "davi",
   "src": [
    40.36,
    42.2
   ],
   "text": [
    "EU OLHEI.",
    "EU SEI QUE",
    "NÃO PODIA."
   ]
  },
  {
   "voice": "davi",
   "src": [
    42.61,
    44.02
   ],
   "text": [
    "E NO VIDRO...",
    "NÃO ERA ELE."
   ]
  },
  {
   "voice": "davi",
   "src": [
    44.35,
    47.45
   ],
   "text": [
    "NA CÂMERA",
    "DO CAIXA,",
    "EU ESTAVA SOZINHO.",
    "FALANDO",
    "COM NINGUÉM."
   ]
  },
  {
   "voice": "bento",
   "src": [
    3.64,
    6.54
   ],
   "text": [
    "O DE SEMPRE,",
    "FILHO.",
    "VOCÊ SABE",
    "QUAL É."
   ]
  },
  {
   "voice": "davi",
   "src": [
    47.71,
    49.72
   ],
   "text": [
    "SE EU ATENDESSE,",
    "TALVEZ ELE",
    "FOSSE EMBORA."
   ]
  },
  {
   "voice": "davi",
   "src": [
    50.0,
    52.66
   ],
   "text": [
    "SE EU DISSESSE",
    "QUE ESTAVA FECHADO...",
    "EU IA TER",
    "QUE FECHAR."
   ]
  },
  {
   "voice": "davi",
   "src": [
    53.01,
    55.83
   ],
   "text": [
    "ERAM 3H07.",
    "FALTAVAM",
    "26 MINUTOS."
   ]
  },
  {
   "voice": "davi",
   "src": [
    56.11,
    58.22
   ],
   "text": [
    "ATENDO...",
    "OU ESTÁ FECHADO?"
   ]
  }
 ],

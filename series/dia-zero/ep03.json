    2.16
   ],
   "text": [
    "DOIS METROS ATÉ O",
    "PRÉDIO AO LADO.",
    "TALVEZ TRÊS."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    2.65,
    5.64
   ],
   "text": [
    "NÃO PENSEI.",
    "SÓ CORRI."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    6.07,
    7.8
   ],
   "text": [
    "EU TE PEGO.",
    "CONFIA EM MIM."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    8.1,
    9.8
   ],
   "text": [
    "ELE PULOU.",
    "E EU SEGUREI."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    10.25,
    12.36
   ],
   "text": [
    "DESCEMOS DEVAGAR.",
    "UM DEGRAU DE",
    "CADA VEZ."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    12.84,
    14.18
   ],
   "text": [
    "À NOITE ELES CORREM.",
    "ENTÃO ESPERAMOS."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    14.54,
    17.03
   ],
   "text": [
    "DE DIA, ELES",
    "SÃO LENTOS.",
    "MAS CONTINUAM OUVINDO."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    17.38,
    19.2
   ],
   "text": [
    "UM CACO DE VIDRO.",
    "FOI O SUFICIENTE."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    19.56,
    20.71
   ],
   "text": [
    "CORRE!",
    "PRO POSTO!"
   ]
  },
  {
   "voice": "roberta",
   "src": [
    21.14,
    24.88
   ],
   "text": [
    "NINGUÉM RESPIRA.",
    "NINGUÉM SE MEXE."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    25.31,
    26.11
   ],
   "text": [
    "AÍ O RÁDIO CHIOU.",
    "NA MINHA MÃO."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    26.59,
    27.5
   ],
   "text": [
    "ELA DISSE O",
    "MEU NOME."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    27.84,
    29.87
   ],
   "text": [
    "A MINHA IRMÃ...",
    "ELA TÁ VIVA."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    30.3,
    35.48
   ],
   "text": [
    "A PONTE.",
    "DOIS DIAS.",
    "E O EXÉRCITO",
    "NÃO ESPERA NINGUÉM."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    35.86,
    38.44
   ],
   "text": [
    "E O HOSPITAL...",
    "ERA DE ONDE TODOS",
    "ELES TINHAM SAÍDO."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    38.89,
    44.36
   ],
   "text": [
    "BUSCO A MINHA IRMÃ...",
    "OU CORRO PRA PONTE?"
   ]
  },
  {
   "voice": "rafa",
   "src": [
    0.0,
    0.95
   ],
   "text": [
    "VOCÊ VAI PRIMEIRO."
   ]
  },
  {
   "voice": "rafa",
   "src": [
    1.43,
    4.98
   ],
   "text": [
    "A PONTE FECHA DAQUI",
    "A DOIS DIAS.",
    "O HOSPITAL É",
    "PRO OUTRO LADO."
   ]
  },
  {
   "voice": "rafa",
   "src": [
    5.66,
    7.47
   ],
   "text": [
    "VOCÊ IA ME",
    "LARGAR DE NOVO?"
   ]
  },
  {
   "voice": "lia",
   "src": [
    0.0,
    3.13
   ],
   "text": [
    "ROBERTA...",
    "SE VOCÊ ESTIVER OUVINDO..."
   ]
  },
  {
   "voice": "lia",
   "src": [
    3.47,
    8.12
   ],
   "text": [
    "SOU EU, A LIA.",
    "ESTOU NO HOSPITAL CENTRAL.",
    "TRÊS BATIDAS."
   ]
  }

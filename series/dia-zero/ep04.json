 "subs": [
  {
   "voice": "roberta",
   "src": [
    0.0,
    1.07
   ],
   "text": [
    "DESLIGUEI O RÁDIO."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    1.64,
    4.24
   ],
   "text": [
    "SE EU OUVISSE A",
    "VOZ DELA DE NOVO,",
    "EU VOLTAVA."
   ]
  },
  {
   "voice": "rafa",
   "src": [
    0.0,
    1.19
   ],
   "text": [
    "VOCÊ NÃO VAI VOLTAR?"
   ]
  },
  {
   "voice": "roberta",
   "src": [
    4.67,
    5.01
   ],
   "text": [
    "NÃO."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    5.33,
    6.25
   ],
   "text": [
    "A GENTE VAI JUNTO."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    6.6,
    7.54
   ],
   "text": [
    "PELOS TRILHOS."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    7.85,
    8.98
   ],
   "text": [
    "NINGUÉM ANDA LÁ EMBAIXO."
   ]
  },
  {
   "voice": "rafa",
   "src": [
    1.63,
    3.03
   ],
   "text": [
    "TEM ALGUÉM DENTRO",
    "DO VAGÃO."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    9.47,
    10.15
   ],
   "text": [
    "NÃO ERA ALGUÉM."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    10.61,
    11.58
   ],
   "text": [
    "ERAM VÁRIOS."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    11.98,
    13.21
   ],
   "text": [
    "ESPERAMOS O VAGÃO PASSAR."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    13.66,
    14.96
   ],
   "text": [
    "A NOITE CHEGOU PRIMEIRO."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    15.37,
    16.43
   ],
   "text": [
    "À NOITE ELES CORREM."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    16.88,
    18.53
   ],
   "text": [
    "E A PONTE ESTAVA",
    "A UM QUARTEIRÃO."
   ]
  },
  {
   "voice": "soldado",
   "src": [
    0.0,
    3.87
   ],
   "text": [
    "A TRAVESSIA FECHA",
    "ÀS SEIS HORAS.",
    "NINGUÉM PASSA DEPOIS."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    18.91,
    20.81
   ],
   "text": [
    "O MEGAFONE.",
    "TODOS OUVIRAM."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    21.12,
    22.72
   ],
   "text": [
    "ENTRA!",
    "ENTRA NO CARRO!"
   ]
  },
  {
   "voice": "roberta",
   "src": [
    23.08,
    24.08
   ],
   "text": [
    "ELES CERCARAM O CARRO."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    24.58,
    25.52
   ],
   "text": [
    "NINGUÉM RESPIRA."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    25.96,
    27.57
   ],
   "text": [
    "LIGUEI O RÁDIO",
    "NO VOLUME MÍNIMO."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    27.95,
    29.26
   ],
   "text": [
    "EU PRECISAVA OUVIR ELA."
   ]
  },
  {
   "voice": "lia",
   "src": [
    0.0,
    0.88
   ],
   "text": [
    "ROBERTA..."
   ]
  },
  {
   "voice": "lia",
   "src": [
    1.55,
    2.52
   ],
   "text": [
    "O HOSPITAL CAIU."
   ]
  },
  {
   "voice": "lia",
   "src": [
    3.06,
    4.38
   ],
   "text": [
    "EU NÃO VOU",
    "CONSEGUIR SAIR."
   ]
  },
  {
   "voice": "lia",
   "src": [
    4.83,
    7.22
   ],
   "text": [
    "ATRAVESSA.",
    "POR MIM."
   ]
  },
  {
   "voice": "lia",
   "src": [
    7.59,
    8.52
   ],
   "text": [
    "PROMETE."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    29.61,
    30.75
   ],
   "text": [
    "EU PROMETO."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    31.2,
    32.31
   ],
   "text": [
    "E O RÁDIO",
    "FICOU MUDO."
   ]
  },
  {
   "voice": "rafa",
   "src": [
    3.55,
    4.71
   ],
   "text": [
    "ESSE CARRO TEM ALARME."
   ]
  },
  {
   "voice": "rafa",
   "src": [
    5.18,
    7.15
   ],
   "text": [
    "SE TOCAR, ELES VÊM",
    "TODOS PRA CÁ."
   ]
  },
  {
   "voice": "rafa",
   "src": [
    7.54,
    9.04
   ],
   "text": [
    "E A GENTE SAI",
    "PELO OUTRO LADO."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    32.74,
    36.55
   ],
   "text": [
    "SE O ALARME TOCASSE,",
    "A GENTE TERIA SEGUNDOS.",
    "SÓ SEGUNDOS."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    36.9,
    37.91
   ],
   "text": [
    "OU ESPERAR O DIA."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    38.33,
    40.03
   ],
   "text": [
    "DE DIA, ELES",
    "FICAM LENTOS."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    40.35,
    41.74
   ],
   "text": [
    "MAS A PONTE",
    "FECHA ÀS SEIS."
   ]
  },
  {
   "voice": "rafa",
   "src": [
    9.38,
    10.28
   ],
   "text": [
    "EU CONFIO EM VOCÊ."
   ]
  },
  {
   "voice": "rafa",
   "src": [
    10.64,
    11.65
   ],
   "text": [
    "VOCÊ DECIDE."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    42.21,
    44.83
   ],
   "text": [

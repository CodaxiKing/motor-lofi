 "subs": [
  {
   "voice": "lia",
   "src": [
    0.0,
    4.74
   ],
   "text": [
    "DIA 1.",
    "MEU PRIMEIRO PACIENTE",
    "ACORDOU.",
    "FOI ATRÁS DO *BIPE*."
   ]
  },
  {
   "voice": "lia",
   "src": [
    5.21,
    10.0
   ],
   "text": [
    "DESLIGUEI O MONITOR,",
    "E ELE PAROU.",
    "ELES NÃO ENXERGAM.",
    "ELES *ESCUTAM*."
   ]
  },
  {
   "voice": "lia",
   "src": [
    10.44,
    14.58
   ],
   "text": [
    "UM SOLDADO DEIXOU",
    "O RÁDIO COMIGO.",
    "A PONTE FECHA",
    "ÀS *SEIS*."
   ]
  },
  {
   "voice": "lia",
   "src": [
    15.11,
    20.71
   ],
   "text": [
    "CHEGUEM À PONTE",
    "ANTES DO DIA CINCO.",
    "*TRÊS BATIDAS*.",
    "A NOITE INTEIRA."
   ]
  },
  {
   "voice": "lia",
   "src": [
    21.14,
    24.41
   ],
   "text": [
    "NO DIA TRÊS,",
    "ALGUÉM RESPONDEU.",
    "ERA A MINHA *IRMÃ*."
   ]
  },
  {
   "voice": "lia",
   "src": [
    24.8,
    29.5
   ],
   "text": [
    "DIA QUATRO,",
    "O HOSPITAL *CAIU*.",
    "ME TRANQUEI",
    "E ME DESPEDI DELA."
   ]
  },
  {
   "voice": "lia",
   "src": [
    29.75,
    38.32
   ],
   "text": [
    "ÀS SEIS, EU OUVI:",
    "\"LIA, EU ATRAVESSEI.\"",
    "ESTAVAM ATRÁS DA PORTA.",
    "SE EU *FALASSE*,",
    "ELES OUVIAM."
   ]
  },
  {
   "voice": "lia",
   "src": [
    38.73,
    40.04
   ],
   "text": [
    "ENTÃO EU BATI",
    "NO MICROFONE."
   ]
  },
  {
   "voice": "lia",
   "src": [
    40.52,
    41.43
   ],
   "text": [
    "*TRÊS VEZES*."
   ]
  },
  {
   "voice": "lia",
   "src": [
    42.3,
    45.79
   ],
   "text": [
    "EU AINDA ESTOU AQUI.",
    "E O RÁDIO CONTINUA",
    "*LIGADO*."
   ]
  }
 ],

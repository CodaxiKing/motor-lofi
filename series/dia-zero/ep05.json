 "subs": [
  {
   "voice": "roberta",
   "src": [
    0.0,
    2.26
   ],
   "text": [
    "BARULHO.",
    "A GENTE FAZ *BARULHO*."
   ]
  },
  {
   "voice": "rafa",
   "src": [
    0.0,
    2.15
   ],
   "text": [
    "EU SABIA QUE VOCÊ",
    "IA *ESCOLHER* ISSO."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    2.75,
    5.08
   ],
   "text": [
    "CONTEI ATÉ *TRÊS*.",
    "COMO A LIA ENSINOU."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    5.52,
    7.83
   ],
   "text": [
    "UM...",
    "DOIS...",
    "*TRÊS*."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    8.23,
    11.33
   ],
   "text": [
    "TODOS FORAM PRO *CARRO*.",
    "TODOS, MENOS A GENTE."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    11.72,
    15.3
   ],
   "text": [
    "ELE PASSOU TÃO PERTO",
    "QUE EU SENTI",
    "O *FRIO*."
   ]
  },
  {
   "voice": "rafa",
   "src": [
    2.86,
    5.36
   ],
   "text": [
    "PELA *AVENIDA*!",
    "É SÓ UM QUARTEIRÃO!"
   ]
  },
  {
   "voice": "roberta",
   "src": [
    15.72,
    20.01
   ],
   "text": [
    "O ALARME *CANTAVA*",
    "ATRÁS DA GENTE.",
    "ENQUANTO ELE TOCASSE,",
    "A GENTE TINHA TEMPO."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    20.34,
    24.21
   ],
   "text": [
    "A PONTE.",
    "*ALI*.",
    "DEZENOVE MINUTOS."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    24.56,
    25.61
   ],
   "text": [
    "AÍ O ALARME *PAROU*."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    26.0,
    28.89
   ],
   "text": [
    "NOSSOS *PASSOS*.",
    "ERA O ÚNICO SOM",
    "DA CIDADE."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    29.2,
    29.74
   ],
   "text": [
    "*CORRE*!"
   ]
  },
  {
   "voice": "soldado",
   "src": [
    0.0,
    2.51
   ],
   "text": [
    "ÚLTIMO *AVISO*.",
    "PORTÃO FECHANDO."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    30.04,
    33.85
   ],
   "text": [
    "EU *CAÍ*.",
    "E PENSEI: É AQUI",
    "QUE ELE ME LARGA."
   ]
  },
  {
   "voice": "rafa",
   "src": [
    5.84,
    8.83
   ],
   "text": [
    "VOCÊ ME SEGUROU",
    "NO *TELHADO*.",
    "AGORA É A MINHA VEZ."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    34.21,
    35.3
   ],
   "text": [
    "CINCO E CINQUENTA",
    "E *NOVE*."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    35.79,
    38.75
   ],
   "text": [
    "A GENTE *ATRAVESSOU*.",
    "EU CUMPRI, LIA."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    39.15,
    43.42
   ],
   "text": [
    "LIA... É A ROBERTA.",
    "EU *ATRAVESSEI*.",
    "SE VOCÊ ESTIVER",
    "ME OUVINDO..."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    43.84,
    44.38
   ],
   "text": [
    "*CHIADO*."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    44.89,
    45.62
   ],
   "text": [
    "E DEPOIS..."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    46.02,
    46.98
   ],
   "text": [
    "TRÊS *BATIDAS*."
   ]
  },
  {
   "voice": "roberta",
   "src": [
    47.44,
    48.97
   ],
   "text": [
    "*DIA 6*."
   ]
  },
  {

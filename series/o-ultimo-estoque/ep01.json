    3.95
   ],
   "text": [
    "6:50",
    "DA TARDE."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    4.5,
    6.09
   ],
   "text": [
    "O MERCADO BOM PREÇO",
    "ESTÁ *VAZIO*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    6.63,
    8.39
   ],
   "text": [
    "VOCÊ EMPURRA A CAIXA",
    "DE MILHO EM LATA."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    8.98,
    9.52
   ],
   "text": [
    "UMA LATA."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    10.18,
    10.72
   ],
   "text": [
    "DUAS."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    11.28,
    11.69
   ],
   "text": [
    "TRÊS."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    12.29,
    13.36
   ],
   "text": [
    "FALTAM DUAS HORAS."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    13.71,
    14.54
   ],
   "text": [
    "NINGUÉM PRA FALAR."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    15.09,
    16.01
   ],
   "text": [
    "E VOCÊ *GOSTA* ASSIM."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    16.54,
    19.12
   ],
   "text": [
    "NO BALCÃO, O RADINHO",
    "TOCA UMA MÚSICA ANIMADA."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    19.55,
    21.73
   ],
   "text": [
    "O TELEFONE DO MERCADO",
    "TEM UMA *CHAMADA PERDIDA*:"
   ]
  },
  {
   "voice": "narrador",
   "src": [
    22.2,
    24.49
   ],
   "text": [
    "17H45."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    24.92,
    26.11
   ],
   "text": [
    "ENTÃO A MÚSICA *SOME*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    26.57,
    27.46
   ],
   "text": [
    "UMA VOZ DIZ:"
   ]
  },
  {
   "voice": "narrador",
   "src": [
    27.76,
    28.76
   ],
   "text": [
    "FIQUEM EM CASA."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    29.18,
    29.65
   ],
   "text": [
    "NÃO É..."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    29.97,
    30.69
   ],
   "text": [
    "UM *EXERCÍCIO*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    31.16,
    33.57
   ],
   "text": [
    "VOCÊ LARGA A PRANCHETA",
    "E ANDA",
    "ATÉ A FRENTE."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    34.06,
    35.09
   ],
   "text": [
    "O VIDRO ESTÁ *FRIO*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    35.55,
    37.2
   ],
   "text": [
    "LÁ FORA, ALGUÉM",
    "PASSA CORRENDO."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    37.58,
    39.81
   ],
   "text": [
    "UM CARRO *BATIDO*.",
    "O ALARME GRITANDO."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    40.15,
    41.01
   ],
   "text": [
    "UMA MULHER CORRE."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    41.35,
    42.4
   ],
   "text": [
    "OUTRO CORRE ATRÁS."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    42.79,
    43.63
   ],
   "text": [
    "E *DERRUBA* ELA."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    44.09,
    46.8
   ],
   "text": [
    "VOCÊ DÁ UM PASSO",
    "PRA TRÁS."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    47.24,
    48.39
   ],
   "text": [
    "ISSO NÃO É",
    "*BRIGA DE RUA*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    48.78,
    49.43
   ],
   "text": [
    "QUEM CAIU..."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    49.77,
    50.73
   ],
   "text": [
    "ESTÁ SE *LEVANTANDO*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    51.07,
    54.92
   ],
   "text": [
    "UM HOMEM CORRE",
    "*PRA PORTA*.",
    "ELE BATE NO VIDRO.",
    "ATRÁS DELE, MAIS TRÊS."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    55.24,
    57.81
   ],
   "text": [
    "VOCÊ PUXA A CORRENTE.",
    "A PORTA DE AÇO",
    "*DESCE*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    58.15,
    59.23
   ],
   "text": [
    "O CADEADO *BATE*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    59.56,
    61.41
   ],
   "text": [
    "O SOM ECOA",
    "PELO MERCADO VAZIO."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    61.82,
    62.37
   ],
   "text": [
    "LÁ FORA,"
   ]
  },
  {
   "voice": "narrador",
   "src": [
    62.69,
    63.23
   ],
   "text": [
    "TUDO *PARA*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    63.65,
    64.22
   ],
   "text": [
    "REGRA UM:"
   ]
  },
  {
   "voice": "narrador",
   "src": [
    64.61,
    65.72
   ],
   "text": [
    "ELES VÊM",
    "PELO *BARULHO*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    66.09,
    67.8
   ],
   "text": [
    "A PORTA DOS FUNDOS",
    "ESTÁ *ABERTA*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    68.16,
    68.81
   ],
   "text": [
    "VOCÊ TRANCA."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    69.23,
    70.43
   ],
   "text": [
    "NO CHÃO, UM CRACHÁ:"
   ]
  },
  {
   "voice": "narrador",
   "src": [
    70.84,
    72.17
   ],
   "text": [
    "*SÉRGIO*, GERENTE."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    72.55,
    74.33
   ],
   "text": [
    "ÀS SEIS, ELE",
    "APONTOU O RELÓGIO:"
   ]
  },
  {
   "voice": "narrador",
   "src": [
    74.79,
    75.75
   ],
   "text": [
    "*MAIS DUAS HORAS*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    76.13,
    78.36
   ],
   "text": [
    "DEPOIS SAIU CORRENDO,",
    "COM O CELULAR",
    "NA ORELHA."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    78.73,
    79.33
   ],
   "text": [
    "UM ESTALO."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    79.69,
    80.66
   ],
   "text": [
    "A LUZ DO BAIRRO",
    "*CAI*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    81.0,
    82.89
   ],
   "text": [
    "SÓ AS LUZES AMARELAS",
    "DE EMERGÊNCIA."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    83.27,
    84.07
   ],
   "text": [
    "E VOCÊ ENTENDE:"
   ]
  },
  {
   "voice": "narrador",
   "src": [
    84.54,
    85.85
   ],
   "text": [
    "VOCÊ VIROU",
    "UMA *SILHUETA*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    86.27,
    89.05
   ],
   "text": [
    "REGRA DOIS: NÃO FIQUE",
    "NA FRENTE DO *VIDRO*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    89.1,
    92.47
   ],
   "text": [
    "O VIDRO DO HORTIFRÚTI",
    "*EXPLODE*.",
    "LARANJAS ROLAM PELO CHÃO."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    92.9,
    93.94
   ],
   "text": [
    "PASSOS ARRASTADOS."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    94.29,
    94.88
   ],
   "text": [
    "*MUITOS*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    95.23,
    100.85
   ],
   "text": [
    "VOCÊ PEGA A BARRA",
    "DOS PALETES E *CORRE*.",
    "PULA AS CAIXAS",
    "DE FRUTAS.",
    "NÃO OLHA PRA TRÁS."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    100.95,
    103.51
   ],
   "text": [
    "VOCÊ PASSA",
    "A PORTA VAIVÉM",
    "E SE JOGA",
    "NO CHÃO."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    103.97,
    105.77
   ],
   "text": [
    "POR BAIXO DELA,",
    "DOIS PÉS."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    106.13,
    106.7
   ],
   "text": [
    "*PARADOS*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    106.75,
    108.31
   ],
   "text": [
    "VOCÊ SOBE",
    "A ESCADA DE FERRO."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    108.63,
    110.52
   ],
   "text": [
    "PUXA ELA PRA CIMA.",
    "A TRAVA *ESTALA*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    110.84,
    112.07
   ],
   "text": [
    "CAIXAS ATÉ O TETO."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    112.47,
    113.53
   ],
   "text": [
    "COMIDA *PRA ANOS*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    113.89,
    114.81
   ],
   "text": [
    "E NINGUÉM PRA FALAR."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    115.32,
    116.13
   ],
   "text": [
    "IGUAL À SUA AVÓ:"
   ]
  },
  {
   "voice": "narrador",
   "src": [
    116.54,
    118.4
   ],
   "text": [
    "NINGUÉM PERCEBEU",
    "POR *DOIS DIAS*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    118.75,
    119.97
   ],
   "text": [
    "O RÁDIO DOS SEGURANÇAS."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    120.28,
    120.92
   ],
   "text": [
    "PILHA *FRACA*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    121.29,
    124.76
   ],
   "text": [
    "UMA VOZ: PORTÃO LESTE,",
    "ATÉ AS DEZ.",
    "*VENHAM AGORA*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    125.1,
    127.62
   ],
   "text": [
    "A JANELA BASCULANTE.",
    "O CANO",
    "ATÉ O BECO."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    127.94,
    129.92
   ],
   "text": [
    "*TRÊS QUADRAS*.",
    "SEM FAZER BARULHO."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    130.41,
    131.15
   ],
   "text": [
    "ENTÃO COMEÇA."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    131.6,
    132.3
   ],
   "text": [
    "UMA BATIDA."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    132.69,
    133.23
   ],
   "text": [
    "DUAS."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    133.64,
    134.11
   ],
   "text": [
    "TRÊS."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    134.44,
    135.86
   ],
   "text": [
    "SEMPRE NO MESMO *RITMO*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    136.25,
    137.04
   ],
   "text": [
    "NÃO É O PORTÃO."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    137.42,
    138.89
   ],
   "text": [
    "AS BATIDAS",
    "VÊM DE DENTRO."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    139.28,
    140.15
   ],
   "text": [
    "DA CÂMARA *FRIA*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    140.58,
    141.68
   ],
   "text": [
    "E NO VIDRO EMBAÇADO,"
   ]
  },
  {
   "voice": "narrador",
   "src": [
    142.06,
    143.01
   ],
   "text": [
    "ALGUÉM DE *ÓCULOS*."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    143.4,
    143.87
   ],
   "text": [
    "E VOCÊ?"
   ]
  },
  {
   "voice": "narrador",
   "src": [
    144.27,
    146.38
   ],
   "text": [
    "SAÍA PELA JANELA",
    "ATÉ O PORTÃO LESTE..."
   ]
  },
  {
   "voice": "narrador",
   "src": [
    146.7,
    148.92
   ],
   "text": [
    "OU FICAVA NO ESTOQUE",
    "COM QUEM ESTÁ",
    "*LÁ DENTRO*?"
   ]
  }

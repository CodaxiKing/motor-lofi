  },
  {
   "voice": "sergio",
   "src": [
    23.31,
    25.6
   ],
   "text": [
    "NO MEIO DA GENTE,",
    "ALGUÉM PEGA",
    "A MINHA *MÃO*."
   ]
  },
  {
   "voice": "sergio",
   "src": [
    26.08,
    26.65
   ],
   "text": [
    "EU PUXO."
   ]
  },
  {
   "voice": "sergio",
   "src": [
    27.01,
    28.98
   ],
   "text": [
    "EU TIRO A GRAVATA",
    "E AMARRO NO PULSO."
   ]
  },
  {
   "voice": "sergio",
   "src": [
    29.36,
    30.5
   ],
   "text": [
    "O POSTO",
    "FICA PRA LÁ."
   ]
  },
  {
   "voice": "sergio",
   "src": [
    30.92,
    32.12
   ],
   "text": [
    "O MERCADO, PRA CÁ."
   ]
  },
  {
   "voice": "sergio",
   "src": [
    32.53,
    34.34
   ],
   "text": [
    "E EU DEIXEI",

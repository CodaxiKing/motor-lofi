   "src": [
    14.68,
    15.67
   ],
   "text": [
    "*MAIS DUAS HORAS*."
   ]
  },
  {
   "voice": "sergio",
   "src": [
    16.14,
    22.93
   ],
   "text": [
    "TRÊS QUADRAS",
    "ATÉ O POSTO.",
    "NA AVENIDA, SIRENE,",
    "ALARME, GENTE CORRENDO",
    "PRO LADO *ERRADO*."

 "subs": [
  {
   "voice": "davi",
   "src": [
    0.0,
    1.58
   ],
   "text": [
    "A LOJA",
    "ESTÁ *FECHADA*."
   ]
  },
  {
   "voice": "bento",
   "src": [
    0.0,
    0.96
   ],
   "text": [
    "FECHADA?"
   ]
  },
  {
   "voice": "bento",
   "src": [
    1.77,
    3.71
   ],
   "text": [
    "TUDO BEM.",
    "EU *ESPERO*."
   ]
  },
  {
   "voice": "davi",
   "src": [
    2.27,
    3.97
   ],
   "text": [
    "PARADO",
    "DO LADO DE FORA."
   ]
  },
  {
   "voice": "davi",
   "src": [
    4.4,
    6.23
   ],
   "text": [
    "SORRINDO.",
    "SEM *PISCAR*."
   ]
  },
  {
   "voice": "davi",
   "src": [
    6.64,
    8.35
   ],
   "text": [
    "ATÉ AS 3H33."
   ]
  },
  {
   "voice": "davi",
   "src": [
    8.75,
    11.43
   ],
   "text": [
    "ÀS 3H33,",
    "ELE NÃO ESTAVA",
    "MAIS LÁ."
   ]
  },
  {
   "voice": "davi",
   "src": [
    11.83,
    13.81
   ],
   "text": [
    "NEM NO PÁTIO.",
    "NEM NAS *CÂMERAS*."
   ]
  },
  {
   "voice": "davi",
   "src": [
    14.25,
    17.02
   ],
   "text": [
    "QUANDO O SOL NASCEU,",
    "JUREI QUE",
    "NÃO *VOLTAVA*."
   ]
  },
  {
   "voice": "davi",
   "src": [
    17.51,
    19.58
   ],
   "text": [
    "MAS A DIÁRIA",
    "PAGAVA O ALUGUEL."
   ]
  },
  {
   "voice": "sonia",
   "src": [
    0.0,
    2.45
   ],
   "text": [
    "VOCÊ VOLTOU, DAVI.",
    "EU SABIA."
   ]
  },
  {
   "voice": "sonia",
   "src": [
    2.93,
    5.04
   ],
   "text": [
    "SEGUIU A",
    "REGRA TRÊS.",
    "MUITO BEM."
   ]
  },
  {
   "voice": "davi",
   "src": [
    20.08,
    21.06
   ],
   "text": [
    "COMO A SENHORA",
    "SABE?"
   ]
  },
  {
   "voice": "sonia",
   "src": [
    5.54,
    7.71
   ],
   "text": [
    "EU VEJO",
    "AS *CÂMERAS*.",
    "BOA NOITE."
   ]
  },
  {
   "voice": "davi",
   "src": [
    21.55,
    24.66
   ],
   "text": [
    "ÀS 2H50,",
    "FUI AO DEPÓSITO."
   ]
  },
  {
   "voice": "davi",
   "src": [
    25.21,
    28.37
   ],
   "text": [
    "A CÂMARA FRIA",
    "ESTAVA TRANCADA.",
    "COM O CADEADO",
    "DO *IVO*."
   ]
  },
  {
   "voice": "davi",
   "src": [
    28.88,
    30.76
   ],
   "text": [
    "TRÊS BATIDAS.",
    "DE *DENTRO*."
   ]
  },
  {
   "voice": "ivo",
   "src": [
    0.0,
    2.22
   ],
   "text": [
    "TEM ALGUÉM AÍ?",
    "POR FAVOR..."
   ]
  },
  {
   "voice": "ivo",
   "src": [
    2.69,
    4.36
   ],
   "text": [
    "TÁ *FRIO*.",
    "ABRE."
   ]
  },
  {
   "voice": "davi",
   "src": [
    31.2,
    31.71
   ],
   "text": [
    "QUEM TÁ AÍ?"
   ]
  },
  {
   "voice": "ivo",
   "src": [
    4.98,
    6.57
   ],
   "text": [
    "SOU EU...",
    "O *IVO*."
   ]
  },
  {
   "voice": "ivo",
   "src": [
    7.18,
    8.06
   ],
   "text": [
    "EU TRABALHAVA AQUI."
   ]
  },
  {
   "voice": "davi",
   "src": [
    32.2,
    34.56
   ],
   "text": [
    "NA CÂMERA...",
    "NÃO TINHA",
    "*NINGUÉM*."
   ]
  },
  {
   "voice": "davi",
   "src": [
    34.97,
    37.64
   ],
   "text": [
    "O VIDRO",
    "*EMBAÇOU*.",
    "COM A FORMA",
    "DE UM ROSTO."
   ]
  },
  {
   "voice": "ivo",
   "src": [
    8.52,
    10.79
   ],
   "text": [
    "DAVI...",
    "A CHAVE TÁ",
    "NO SEU BOLSO."
   ]
  },
  {
   "voice": "ivo",
   "src": [
    11.32,
    12.63
   ],
   "text": [
    "EU OUVI A SÔNIA",
    "TE CHAMAR."
   ]
  },
  {
   "voice": "davi",
   "src": [
    38.16,
    39.06
   ],
   "text": [
    "ELE DISSE",
    "O MEU *NOME*."
   ]
  },
  {
   "voice": "davi",
   "src": [
    39.72,
    44.26
   ],
   "text": [
    "REGRA CINCO.",
    "E A REGRA QUATRO:",
    "SE BATEREM DE DENTRO,",
    "NÃO ABRA."
   ]
  },
  {
   "voice": "davi",
   "src": [
    44.68,
    47.05
   ],
   "text": [
    "EU TINHA A *CHAVE*.",
    "E O NÚMERO",
    "DA GERENTE."
   ]
  },
  {
   "voice": "ivo",
   "src": [
    13.01,
    15.8
   ],
   "text": [
    "POR FAVOR...",
    "FAZ QUARENTA",
    "*NOITES*."
   ]
  },
  {
   "voice": "davi",
   "src": [
    47.43,
    48.66
   ],
   "text": [
    "ABRO A",
    "CÂMARA FRIA..."
   ]
  },
  {
   "voice": "davi",
   "src": [
    49.1,
    50.52
   ],
   "text": [
    "OU LIGO",
    "PRA *GERENTE*?"
   ]
  }
 ],

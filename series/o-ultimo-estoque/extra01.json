   ]
  },
  {
   "voice": "sergio",
   "src": [
    34.81,
    36.02
   ],
   "text": [
    "A PORTA DOS FUNDOS."
   ]
  },
  {
   "voice": "sergio",
   "src": [
    36.47,
    37.94
   ],
   "text": [
    "EU ENTRO",
    "E NÃO *FECHO*."
